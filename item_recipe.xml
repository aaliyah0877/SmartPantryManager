<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/card_dark">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <!-- Front of card (Uiverse 3D Glassmorphic Design with Wheat & MistyRose accents) -->
        <FrameLayout
            android:id="@+id/recipeFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/uiverse_card_gradient"
            android:clipChildren="false">

            <!-- Logo Container (Top Right 5 Concentric Circles from Uiverse) -->
            <FrameLayout
                android:id="@+id/logoContainer"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="top|end"
                android:clipChildren="false">

                <View
                    android:id="@+id/circle1"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/fancy_circle_wheat"
                    android:alpha="0.4" />

                <View
                    android:id="@+id/circle2"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/fancy_circle_misty"
                    android:alpha="0.5" />

                <View
                    android:id="@+id/circle3"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="17dp"
                    android:layout_marginEnd="17dp"
                    android:background="@drawable/fancy_circle_teal_light"
                    android:alpha="0.6" />

                <View
                    android:id="@+id/circle4"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="23dp"
                    android:layout_marginEnd="23dp"
                    android:background="@drawable/fancy_circle_teal_dark"
                    android:alpha="0.7" />

                <View
                    android:id="@+id/circle5"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="30dp"
                    android:background="@drawable/fancy_circle_teal"
                    android:alpha="0.9" />

            </FrameLayout>

            <!-- Recipe Icon -->
            <ImageView
                android:id="@+id/recipeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="43dp"
                android:layout_marginEnd="43dp"
                android:src="@drawable/ic_restaurant"
                app:tint="@color/surface" />

            <!-- Glass Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:background="@drawable/glass_overlay_bg" />

            <!-- Content Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="bottom">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/recipeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/btnFavorite"
                        android:textColor="@color/on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFavorite"
                        style="@style/Widget.Material3.Button.Icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        app:icon="@android:drawable/btn_star_big_off"
                        app:iconSize="24dp"
                        app:iconPadding="0dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        app:iconTint="@color/accent" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/neu_container_background"
                    android:padding="12dp"
                    android:elevation="4dp">

                    <TextView
                        android:id="@+id/recipeDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/tap_to_see_ingredients"
                        android:textSize="11sp"
                        android:textColor="@color/primary_dark"
                        android:textStyle="italic" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Back of card (Rotating Glow Border) -->
        <FrameLayout
            android:id="@+id/recipeBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/card_dark"
            android:alpha="0">

            <!-- The Glow (Animated Rotation in Java) -->
            <View
                android:id="@+id/glowView"
                android:layout_width="500dp"
                android:layout_height="500dp"
                android:layout_gravity="center"
                android:background="@drawable/rotating_glow_gradient" />

            <!-- Content Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@color/card_dark"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ingredients_needed"
                    android:textColor="@color/surface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/recipeIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/recipe_instructions"
                    android:textColor="@color/surface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/recipeInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center"
                    android:maxLines="4"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tap_to_return"
                    android:textSize="12sp"
                    android:textColor="#88FFFFFF"
                    android:textStyle="italic" />

            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
